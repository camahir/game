    circle.setAttribute('fill', color);
    const ring = document.createElementNS(ns,'circle');
    ring.setAttribute('cx', cx); ring.setAttribute('cy', cy); ring.setAttribute('r', CELL*0.36);
    ring.setAttribute('fill','none'); ring.setAttribute('stroke', color); ring.setAttribute('stroke-opacity','0.35'); ring.setAttribute('stroke-width','2');
    g.appendChild(ring); g.appendChild(circle);
