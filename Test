<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Bloc</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0b0e;
  --bg-elevated:#111318;
  --surface:rgba(255,255,255,0.045);
  --surface-hover:rgba(255,255,255,0.07);
  --surface-2:rgba(255,255,255,0.06);
  --border:rgba(255,255,255,0.09);
  --border-soft:rgba(255,255,255,0.05);
  --text:#eef0f3;
  --text-dim:#9498a3;
  --text-faint:#5c6070;
  --p1:#4c7eff;
  --p1-glow:rgba(76,126,255,0.45);
  --p2:#f2a65a;
  --p2-glow:rgba(242,166,90,0.45);
  --wall:#c7cbd6;
  --wall-ghost:rgba(242,166,90,0.35);
  --danger:#e8585f;
  --success:#5fcf8f;
  --radius-lg:20px;
  --radius-md:14px;
  --radius-sm:9px;
  --ease:cubic-bezier(.22,.9,.34,1);
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
}
*{box-sizing:border-box; margin:0; padding:0;}
html,body{height:100%;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',-apple-system,sans-serif;
  min-height:100vh;
  overflow-x:hidden;
}
.mono{font-family:'JetBrains Mono',monospace;}
.display{font-family:'Sora',sans-serif;}
button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit;}
button:focus-visible, [tabindex]:focus-visible{outline:2px solid var(--p1); outline-offset:3px; border-radius:8px;}
a{color:inherit;}

#app{min-height:100vh; display:flex; flex-direction:column;}
.view{display:none; flex:1; flex-direction:column;}
.view.active{display:flex;}

/* ---------- shared bits ---------- */
.topbar{
  display:flex; align-items:center; justify-content:space-between;
  padding:22px clamp(18px,4vw,44px);
}
.wordmark{
  font-family:'Sora',sans-serif; font-weight:800; font-size:19px; letter-spacing:0.01em;
  display:flex; align-items:center; gap:10px;
}
.wordmark .dot-pair{display:flex; gap:4px;}
.wordmark .dot-pair span{width:8px; height:8px; border-radius:50%; display:block;}
.wordmark .dot-pair span:first-child{background:var(--p1); box-shadow:0 0 10px var(--p1-glow);}
.wordmark .dot-pair span:last-child{background:var(--p2); box-shadow:0 0 10px var(--p2-glow);}
.icon-btn{
  width:38px; height:38px; border-radius:11px; display:flex; align-items:center; justify-content:center;
  background:var(--surface); border:1px solid var(--border-soft); color:var(--text-dim);
  transition:all .18s var(--ease);
}
.icon-btn:hover{background:var(--surface-hover); color:var(--text);}
.icon-btn svg{width:17px; height:17px;}

.glass-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  backdrop-filter:blur(20px);
}

/* ---------- HOME ---------- */
#view-home{align-items:center; justify-content:center; padding:20px;}
.home-wrap{width:100%; max-width:440px; padding:20px 0 40px;}
.home-hero{text-align:center; margin-bottom:30px;}
.home-hero .eyebrow{
  font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.22em; text-transform:uppercase;
  color:var(--p1); margin-bottom:16px; display:block;
}
.home-hero h1{
  font-family:'Sora',sans-serif; font-weight:800; font-size:clamp(46px,12vw,64px);
  letter-spacing:-0.01em; line-height:0.95; margin-bottom:16px; text-transform:uppercase;
}
.home-hero h1 span{color:var(--p1);}
.home-hero .rule{width:36px; height:2px; background:var(--p1); margin:0 auto 16px; border-radius:2px;}
.home-hero p{color:var(--text-dim); font-size:15px; max-width:320px; margin:0 auto; line-height:1.5;}

.mini-board{width:76px; height:76px; margin:0 auto 26px; opacity:0.9;}

.menu-stack{display:flex; flex-direction:column; gap:14px;}

.menu-row{
  display:flex; align-items:center; gap:14px; width:100%; padding:18px; border-radius:16px;
  background:var(--surface); border:1px solid var(--border); color:var(--text);
  transition:transform .16s var(--ease), filter .16s var(--ease), background .16s var(--ease);
  text-align:left;
}
.menu-row:hover{transform:translateY(-2px); filter:brightness(1.08);}
.menu-row:active{transform:translateY(0) scale(0.99);}
.menu-row .mr-icon{
  width:38px; height:38px; border-radius:11px; flex:none;
  display:flex; align-items:center; justify-content:center;
}
.menu-row .mr-icon svg{width:20px; height:20px;}
.menu-row .mr-text{flex:1;}
.menu-row .mr-title{
  font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:0.04em; display:block;
}
.menu-row .mr-sub{font-size:11.5px; color:var(--text-faint); margin-top:2px; display:block; text-transform:none; letter-spacing:0;}
.menu-row .chev{width:16px; height:16px; color:var(--text-faint); flex:none;}

.menu-row.solid{background:var(--p1); border-color:transparent; color:#fff;}
.menu-row.solid .mr-sub{color:rgba(255,255,255,0.75);}
.menu-row.solid .chev{color:rgba(255,255,255,0.85);}

.menu-row.outline{background:var(--surface); border-color:var(--border);}

.menu-row.dashed{background:transparent; border:1.5px dashed rgba(76,126,255,0.4); color:var(--p1);}
.menu-row.dashed .mr-sub{color:var(--text-faint);}
.menu-row.dashed .chev{color:var(--p1);}

.section-divider{
  display:flex; align-items:center; gap:12px; margin:28px 0 14px;
  color:var(--p1); font-family:'JetBrains Mono',monospace; font-size:10.5px;
  letter-spacing:0.16em; text-transform:uppercase;
}
.section-divider::before,.section-divider::after{content:''; flex:1; height:1px; background:var(--border-soft);}

.diff-row{display:flex; gap:8px;}
.diff-pill{
  flex:1; padding:12px 6px; text-align:center; border-radius:11px;
  background:var(--surface); border:1px solid var(--border); font-size:12.5px; font-weight:700;
  text-transform:uppercase; letter-spacing:0.04em;
  color:var(--text-dim); transition:all .15s var(--ease);
}
.diff-pill:hover{color:var(--text); border-color:rgba(255,255,255,0.18);}
.diff-pill.active{background:var(--p1); border-color:var(--p1); color:#fff;}

/* ---------- ONLINE CTA (home) ---------- */
.online-cta{
  display:flex; align-items:center; gap:14px; width:100%; padding:16px 18px; border-radius:18px;
  background:var(--surface-hover); border:1px solid var(--border); color:var(--text); margin-top:2px;
  transition:transform .16s var(--ease), filter .16s var(--ease);
}
.online-cta:hover{transform:translateY(-2px); filter:brightness(1.08);}
.online-cta:active{transform:translateY(0) scale(0.99);}
.online-cta .oc-icon{
  width:40px; height:40px; border-radius:12px; background:transparent;
  display:flex; align-items:center; justify-content:center; color:var(--text); flex:none;
}
.online-cta .oc-icon svg{width:20px; height:20px;}
.online-cta .oc-text{flex:1; text-align:left;}
.online-cta .oc-title{font-weight:700; font-size:14.5px; display:block;}
.online-cta .oc-sub{font-size:11.5px; color:var(--text-faint); margin-top:1px; display:block;}
.online-cta .chev{width:16px; height:16px; color:var(--text-faint); flex:none;}

.home-footer-links{display:flex; align-items:center; justify-content:center; gap:20px; margin-top:26px;}
.home-footer-links .fl-divider{width:1px; height:14px; background:var(--border-soft);}
.home-footer-links button{
  display:flex; align-items:center; gap:7px; font-size:12.5px; font-weight:600;
  text-transform:uppercase; letter-spacing:0.04em; color:var(--text-dim); transition:color .15s;
}
.home-footer-links button svg{width:15px; height:15px; color:var(--p1);}
.home-footer-links button:hover{color:var(--text);}

.stats-panel{
  display:flex; margin-top:26px; border-radius:16px; background:var(--surface); border:1px solid var(--border);
  overflow:hidden;
}
.stats-panel .s-item{
  flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; padding:18px 8px;
  border-left:1px solid var(--border-soft);
}
.stats-panel .s-item:first-child{border-left:none;}
.stats-panel .s-icon{width:18px; height:18px; color:var(--p1);}
.stats-panel .s-num{font-family:'JetBrains Mono',monospace; font-size:18px; font-weight:700; color:var(--text);}
.stats-panel .s-lbl{font-size:9.5px; color:var(--p1); text-transform:uppercase; letter-spacing:0.1em;}

/* ---------- ONLINE PANELS (lobby / waiting) ---------- */
.center-view{flex:1; display:flex; align-items:center; justify-content:center; padding:20px;}
.online-panel{max-width:400px; width:100%; padding:30px 26px;}
.online-panel h2{font-family:'Sora',sans-serif; font-weight:700; font-size:20px; margin-bottom:6px;}
.online-panel .sub{color:var(--text-dim); font-size:13px; line-height:1.55; margin-bottom:24px;}
.or-divider{display:flex; align-items:center; gap:10px; margin:20px 0; color:var(--text-faint); font-size:10.5px; letter-spacing:0.1em; font-family:'JetBrains Mono',monospace;}
.or-divider::before,.or-divider::after{content:''; flex:1; height:1px; background:var(--border-soft);}
.code-input{
  width:100%; padding:15px; border-radius:12px; background:var(--surface); border:1px solid var(--border);
  color:var(--text); font-size:14px; letter-spacing:0.02em; text-align:center;
  margin-bottom:12px; font-family:'JetBrains Mono',monospace;
}
.code-input::placeholder{color:var(--text-faint); letter-spacing:0.04em; text-transform:none;}
.code-input:focus{outline:none; border-color:var(--p1);}
.online-error-text{color:var(--danger); font-size:12.5px; margin-top:12px; text-align:center; min-height:16px;}
.online-note{color:var(--text-faint); font-size:11px; text-align:center; margin-top:16px; line-height:1.5;}

.waiting-panel{max-width:380px; width:100%; padding:36px 26px; text-align:center;}
.room-code-big{font-family:'JetBrains Mono',monospace; font-size:22px; font-weight:700; letter-spacing:0.02em; margin:6px 0 22px; word-break:break-all; padding:0 8px;}
.waiting-row{display:flex; align-items:center; justify-content:center; gap:9px; color:var(--text-dim); font-size:13px;}
.waiting-dot{width:8px; height:8px; border-radius:50%; background:var(--p1); animation:pulseDot 1.3s ease-in-out infinite;}
@keyframes pulseDot{0%,100%{opacity:.25;} 50%{opacity:1;}}

/* ---------- GAME ---------- */
#view-game{padding:14px clamp(14px,3vw,36px) 30px;}
.game-layout{
  flex:1; display:flex; gap:26px; align-items:flex-start; justify-content:center;
  flex-wrap:wrap; max-width:1080px; margin:0 auto; width:100%;
}
.board-col{display:flex; flex-direction:column; align-items:center; gap:14px; flex:none;}
.board-frame{
  padding:18px; border-radius:24px;
  background:var(--surface); border:1px solid var(--border);
  box-shadow:0 30px 70px -30px rgba(0,0,0,0.6);
}
#board-svg{display:block; width:min(76vw,486px); height:min(76vw,486px);}
.cell{fill:rgba(255,255,255,0.03); stroke:rgba(255,255,255,0.045); stroke-width:1; transition:fill .15s;}
.cell.goal-p1{fill:rgba(76,126,255,0.07);}
.cell.goal-p2{fill:rgba(242,166,90,0.07);}
.cell.valid{fill:rgba(76,126,255,0.12); cursor:pointer;}
.cell.valid:hover{fill:rgba(76,126,255,0.24);}
.wallslot{fill:transparent; cursor:pointer;}
.wallslot.legal:hover{fill:var(--wall-ghost);}
.wallslot.armed-legal{fill:rgba(76,126,255,0.20);}
.wallslot.armed-legal:hover{fill:rgba(76,126,255,0.34);}
.wall-rect{fill:var(--wall); rx:3; filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5)); transform-origin:center;}
.wall-rect.enter{animation:wallDrop .32s var(--ease);}
@keyframes wallDrop{from{transform:scaleY(0.15); opacity:0;} to{transform:scaleY(1); opacity:1;}}
.pawn{transition:transform .32s var(--ease); transform-box:fill-box; transform-origin:center;}
.pawn-glow{filter:drop-shadow(0 0 8px currentColor);}

.lobby-btn{
  display:flex; align-items:center; gap:4px; padding:8px 10px 8px 6px; border-radius:11px;
  color:var(--text-dim); font-size:15px; font-weight:500; transition:color .15s var(--ease);
}
.lobby-btn:hover{color:var(--text);}
.lobby-btn svg{width:20px; height:20px;}
.move-count-pill{font-size:12.5px; color:var(--text-faint);}
.move-count-pill span{color:var(--text-dim); font-weight:600;}
.move-count-pill #online-room-prefix{color:var(--success); font-weight:600;}

.players-row{
  display:flex; gap:12px; max-width:1080px; width:100%; margin:0 auto;
  padding:0 clamp(14px,3vw,36px); box-sizing:border-box;
}
.player-card{
  flex:1; background:var(--surface); border:1px solid var(--border); border-left:3px solid transparent;
  border-radius:16px; padding:14px 18px; transition:border-color .18s var(--ease), background .18s var(--ease), box-shadow .18s var(--ease);
}
.player-card.p1{border-left-color:var(--p1);}
.player-card.p2{border-left-color:var(--p2);}
.player-card.active{background:rgba(255,255,255,0.035);}
.player-card.p1.active{box-shadow:0 0 0 1px var(--p1-glow);}
.player-card.p2.active{box-shadow:0 0 0 1px var(--p2-glow);}
.pc-name{font-size:14px; font-weight:600; margin-bottom:8px;}
.pc-walls{display:flex; align-items:center; gap:9px; font-size:19px; font-weight:600;}
.pc-bar{display:inline-block; width:20px; height:8px; border-radius:4px;}
.pc-bar.p1{background:var(--p1);}
.pc-bar.p2{background:var(--p2);}
.pc-of{font-size:12px; color:var(--text-faint); font-weight:400;}

.hint-text{font-size:12px; color:var(--text-faint); line-height:1.5; text-align:center;}

.hint-box{
  display:flex; align-items:flex-start; gap:12px; width:100%; max-width:420px;
  padding:16px 18px; border-radius:16px; background:var(--surface); border:1px solid var(--border);
}
.hint-box .hint-text{text-align:left; color:var(--text-dim);}
.hint-icon{
  width:22px; height:22px; border-radius:50%; flex:none; margin-top:1px;
  display:flex; align-items:center; justify-content:center;
  border:1.5px solid var(--p1); color:var(--p1);
}
.hint-icon svg{width:12px; height:12px;}

.tray-divider{margin:10px 0 4px; width:100%; max-width:420px;}

.timer-pill{
  font-size:12.5px; padding:5px 11px; border-radius:100px; background:var(--surface);
  border:1px solid var(--border); color:var(--text-dim); transition:all .18s var(--ease);
}
.timer-pill.warn{color:var(--p2); border-color:rgba(242,166,90,0.4); background:rgba(242,166,90,0.08);}
.timer-pill.danger{color:var(--danger); border-color:rgba(232,88,95,0.45); background:rgba(232,88,95,0.1); animation:timerPulse 1s ease-in-out infinite;}
@keyframes timerPulse{0%,100%{opacity:1;} 50%{opacity:0.55;}}

.disconnect-banner{
  display:none; align-items:center; justify-content:center; gap:8px;
  max-width:1080px; width:100%; margin:0 auto 4px; padding:0 clamp(14px,3vw,36px); box-sizing:border-box;
}
.disconnect-banner.active{display:flex;}
.disconnect-banner .db-inner{
  display:flex; align-items:center; gap:9px; padding:9px 16px; border-radius:100px;
  background:rgba(232,88,95,0.1); border:1px solid rgba(232,88,95,0.35); color:var(--danger); font-size:12.5px; font-weight:500;
}
.disconnect-banner .db-dot{width:7px; height:7px; border-radius:50%; background:var(--danger); animation:pulseDot 1s ease-in-out infinite;}

/* ---------- WALL TRAY (drag to place) ---------- */
.tray-row{display:flex; gap:12px; margin-top:18px; width:100%; max-width:420px;}
.wall-tile{
  flex:1; display:flex; align-items:center; justify-content:center; gap:11px;
  padding:16px 14px; border-radius:18px; background:var(--surface); border:1px solid var(--border);
  cursor:grab; touch-action:none; -webkit-user-select:none; user-select:none; -webkit-touch-callout:none;
  transition:background .15s var(--ease), border-color .15s var(--ease), opacity .15s var(--ease), box-shadow .15s var(--ease);
}
.wall-tile:hover:not(.disabled){background:var(--surface-hover); border-color:rgba(255,255,255,0.18);}
.wall-tile:active:not(.disabled){cursor:grabbing;}
.wall-tile.dragging{opacity:0.3;}
.wall-tile.disabled{opacity:0.28; cursor:not-allowed; touch-action:auto;}
.wall-tile.armed{background:rgba(76,126,255,0.16); border-color:var(--p1); box-shadow:0 0 0 2px rgba(76,126,255,0.35) inset;}
.wall-tile.shake{animation:tileShake .32s var(--ease);}
@keyframes tileShake{
  0%,100%{transform:translateX(0);}
  25%{transform:translateX(-5px);}
  75%{transform:translateX(5px);}
}
.tile-bar{border-radius:7px; box-shadow:0 2px 5px rgba(0,0,0,0.4); pointer-events:none; flex:none;}
.tile-bar.h{width:26px; height:9px; background:var(--current-color, var(--p1));}
.tile-bar.v{width:9px; height:26px; background:var(--current-color, var(--p1));}
.tile-label{font-size:14px; color:var(--text); font-weight:600; pointer-events:none;}

.bottom-bar{
  display:flex; align-items:center; justify-content:center; gap:10px;
  margin-top:16px; padding:16px; border-radius:18px; background:var(--surface); border:1px solid var(--border);
  width:100%; max-width:420px;
}
.pill-btn{padding:9px 20px; border-radius:100px; font-size:13.5px; font-weight:600; transition:all .15s var(--ease);}
.pill-btn:disabled{opacity:0.35; cursor:not-allowed;}
.ghost-success{background:transparent; border:1px solid rgba(95,207,143,0.4); color:var(--success);}
.ghost-success:hover:not(:disabled){background:rgba(95,207,143,0.1);}
.ghost-primary{background:transparent; border:1px solid rgba(76,126,255,0.4); color:var(--p1);}
.ghost-primary:hover:not(:disabled){background:rgba(76,126,255,0.1);}
.solid-danger{background:var(--danger); color:#fff;}
.solid-danger:hover{background:#d94850;}
.ghost-danger{background:rgba(232,88,95,0.08); border:1px solid rgba(232,88,95,0.4); color:var(--danger);}
.ghost-danger:hover:not(:disabled){background:rgba(232,88,95,0.16);}

#drag-ghost{
  position:fixed; top:0; left:0; z-index:300; pointer-events:none;
  border-radius:7px; background:var(--wall);
  box-shadow:0 10px 24px rgba(0,0,0,0.5), 0 0 0 2px rgba(255,255,255,0.14) inset;
  opacity:0.96;
}
#drag-ghost.valid{background:var(--success); box-shadow:0 10px 24px rgba(0,0,0,0.5), 0 0 0 2px rgba(95,207,143,0.4) inset;}
#drag-ghost.invalid{background:var(--danger); box-shadow:0 10px 24px rgba(0,0,0,0.5), 0 0 0 2px rgba(232,88,95,0.4) inset;}

/* ---------- VICTORY ---------- */
#view-victory{align-items:center; justify-content:center; padding:20px; position:relative; overflow:hidden;}
.victory-card{max-width:380px; width:100%; padding:44px 34px; text-align:center; position:relative; z-index:2;}
.victory-crown{font-size:34px; margin-bottom:14px;}
.victory-card h2{font-family:'Sora',sans-serif; font-weight:800; font-size:28px; margin-bottom:8px;}
.victory-card .vsub{color:var(--text-dim); font-size:13.5px; margin-bottom:26px;}
.victory-stats{display:flex; justify-content:center; gap:28px; margin-bottom:28px; font-family:'JetBrains Mono',monospace;}
.victory-stats .v-num{font-size:20px; font-weight:600;}
.victory-stats .v-lbl{font-size:10px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.06em; margin-top:2px;}
.victory-actions{display:flex; flex-direction:column; gap:9px;}
#confetti-canvas{position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none;}

/* ---------- big primary / secondary buttons ---------- */
.btn{
  padding:13px 20px; border-radius:12px; font-size:14px; font-weight:600; transition:all .16s var(--ease);
}
.btn-primary{background:var(--p1); color:#fff;}
.btn-primary:hover{background:#3d6bef; transform:translateY(-1px);}
.btn-primary:disabled{opacity:0.5; cursor:not-allowed; transform:none;}
.btn-ghost{background:var(--surface); border:1px solid var(--border); color:var(--text);}
.btn-ghost:hover{background:var(--surface-hover);}
.btn-ghost:disabled{opacity:0.5; cursor:not-allowed;}
.btn-full{width:100%;}

/* ---------- modal ---------- */
.modal-backdrop{
  position:fixed; inset:0; background:rgba(6,7,10,0.7); backdrop-filter:blur(4px);
  display:none; align-items:center; justify-content:center; z-index:50; padding:20px;
}
.modal-backdrop.active{display:flex;}
.modal{max-width:420px; width:100%; padding:26px 24px; max-height:82vh; overflow-y:auto;}
