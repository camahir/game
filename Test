   RENDERING
   ============================================================ */
const svgEl = document.getElementById('board-svg');
svgEl.setAttribute('viewBox', `0 0 ${SVG_SIZE} ${SVG_SIZE}`);

function cellX(c){ return c*STEP; }
function cellY(r){ return r*STEP; }

let selectedValidMoves = [];
let armedOrient = null;
let pendingWall = null;

function clearArmed(){ armedOrient = null; pendingWall = null; }

const DEFAULT_HINT = 'Tap a highlighted cell to move. Tap a wall piece, then tap a gap twice to place.';
function updateBoardHint(){
  const hint = document.getElementById('board-hint');
  if(!hint) return;
  if(!state || state.over){ hint.textContent = DEFAULT_HINT; return; }
  if(state.mode==='ai' && state.current===state.aiPlayer){
    hint.textContent = 'Computer is thinking\u2026';
  } else if(state.mode==='online' && !isLocalTurn()){
    hint.textContent = "Waiting for opponent's move\u2026";
  } else if(pendingWall){
    hint.textContent = 'Tap the glowing gap again to place the wall — or tap another gap to move it';
  } else if(armedOrient){
    hint.textContent = 'Tap a highlighted gap to place the wall — or tap the piece again to cancel';
  } else {
    hint.textContent = DEFAULT_HINT;
  }
}

function handleWallSlotTap(w){
  if(pendingWall && pendingWall.r===w.r && pendingWall.c===w.c && pendingWall.orient===w.orient){
    pendingWall = null;
    humanWall(w);
  } else {
    pendingWall = w;
    sfxArm();
    renderBoard();
  }
}

function renderBoard(){
  svgEl.innerHTML = '';
  const blocked = computeBlockedEdges(state.walls);
  const humanTurn = isLocalTurn();
  const ns = 'http://www.w3.org/2000/svg';

  for(let r=0;r<N;r++){
    for(let c=0;c<N;c++){
      const rect = document.createElementNS(ns,'rect');
      rect.setAttribute('x', cellX(c)); rect.setAttribute('y', cellY(r));
      rect.setAttribute('width', CELL); rect.setAttribute('height', CELL);
      rect.setAttribute('rx', 8);
      rect.classList.add('cell');
      const isValid = humanTurn && !state.over && !armedOrient && selectedValidMoves.some(m=>m.r===r&&m.c===c);
      if(!isValid){
        if(r===GOAL_ROW.p1) rect.classList.add('goal-p1');
        else if(r===GOAL_ROW.p2) rect.classList.add('goal-p2');
      }
      if(isValid){
        rect.classList.add('valid');
        rect.setAttribute('tabindex','0');
        rect.setAttribute('role','button');
        rect.setAttribute('aria-label', `Move to row ${r+1}, column ${c+1}`);
        rect.addEventListener('click', ()=>humanMove({r,c}));
        rect.addEventListener('keydown', (e)=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); humanMove({r,c}); }});
      }
      svgEl.appendChild(rect);
    }
  }

  const canPlaceWalls = canHumanPlaceWalls();
  if(canPlaceWalls && armedOrient){
    for(let r=0;r<N-1;r++){
      for(let c=0;c<N-1;c++){
        if(armedOrient==='H'){
          const hw = {r,c,orient:'H'};
          if(!wallOverlaps(hw, state.walls)){
            const hRect = document.createElementNS(ns,'rect');
            hRect.setAttribute('x', cellX(c));
            hRect.setAttribute('y', cellY(r)+CELL-HIT_PAD);
            hRect.setAttribute('width', 2*CELL+GAP);
            hRect.setAttribute('height', GAP+HIT_PAD*2);
            hRect.classList.add('wallslot');
            const legal = isLegalWall(hw, state.walls, state.p1, state.p2);
            if(legal){
              hRect.classList.add('legal');
              const isPending = pendingWall && pendingWall.r===r && pendingWall.c===c && pendingWall.orient==='H';
              if(isPending) hRect.classList.add('armed-legal');
              hRect.setAttribute('tabindex','0'); hRect.setAttribute('role','button');
              hRect.setAttribute('aria-label', isPending ? `Confirm horizontal wall at row ${r+1}, column ${c+1}` : `Select horizontal wall at row ${r+1}, column ${c+1}`);
              hRect.addEventListener('click', ()=>handleWallSlotTap(hw));
            }
            svgEl.appendChild(hRect);
          }
        }
        if(armedOrient==='V'){
          const vw = {r,c,orient:'V'};
          if(!wallOverlaps(vw, state.walls)){
            const vRect = document.createElementNS(ns,'rect');
            vRect.setAttribute('x', cellX(c)+CELL-HIT_PAD);
            vRect.setAttribute('y', cellY(r));
            vRect.setAttribute('width', GAP+HIT_PAD*2);
            vRect.setAttribute('height', 2*CELL+GAP);
            vRect.classList.add('wallslot');
            const legal = isLegalWall(vw, state.walls, state.p1, state.p2);
            if(legal){
              vRect.classList.add('legal');
              const isPending = pendingWall && pendingWall.r===r && pendingWall.c===c && pendingWall.orient==='V';
              if(isPending) vRect.classList.add('armed-legal');
              vRect.setAttribute('tabindex','0'); vRect.setAttribute('role','button');
              vRect.setAttribute('aria-label', isPending ? `Confirm vertical wall at row ${r+1}, column ${c+1}` : `Select vertical wall at row ${r+1}, column ${c+1}`);
              vRect.addEventListener('click', ()=>handleWallSlotTap(vw));
            }
            svgEl.appendChild(vRect);
          }
        }
      }
    }
  }

  for(const w of state.walls){
    const rect = document.createElementNS(ns,'rect');
    if(w.orient==='H'){
      rect.setAttribute('x', cellX(w.c)); rect.setAttribute('y', cellY(w.r)+CELL);
      rect.setAttribute('width', 2*CELL+GAP); rect.setAttribute('height', GAP);
    } else {
      rect.setAttribute('x', cellX(w.c)+CELL); rect.setAttribute('y', cellY(w.r));
