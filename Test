<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
"use strict";

/* ============================================================
   CONSTANTS & CORE GEOMETRY
   ============================================================ */
const N = 9;
const CELL = 56, GAP = 6;
const STEP = CELL + GAP;
const SVG_SIZE = N*CELL + (N-1)*GAP;
const HIT_PAD = 6;

function inBounds(r,c){ return r>=0 && r<N && c>=0 && c<N; }
function posKey(p){ return p.r+','+p.c; }
function edgeKey(a,b){
  let r1=a.r,c1=a.c,r2=b.r,c2=b.c;
  if(r1>r2 || (r1===r2 && c1>c2)){ [r1,c1,r2,c2]=[r2,c2,r1,c1]; }
  return r1+','+c1+'-'+r2+','+c2;
}

function computeBlockedEdges(walls){
  const set = new Set();
  for(const w of walls){
    if(w.orient==='H'){
      set.add(edgeKey({r:w.r,c:w.c},{r:w.r+1,c:w.c}));
      set.add(edgeKey({r:w.r,c:w.c+1},{r:w.r+1,c:w.c+1}));
    } else {
      set.add(edgeKey({r:w.r,c:w.c},{r:w.r,c:w.c+1}));
      set.add(edgeKey({r:w.r+1,c:w.c},{r:w.r+1,c:w.c+1}));
    }
  }
  return set;
}
function canMoveBetween(a,b,blocked){ return !blocked.has(edgeKey(a,b)); }

function wallOverlaps(w, walls){
  for(const o of walls){
    if(o.orient===w.orient){
      if(o.r===w.r && o.c===w.c) return true;
      if(w.orient==='H' && o.r===w.r && Math.abs(o.c-w.c)===1) return true;
      if(w.orient==='V' && o.c===w.c && Math.abs(o.r-w.r)===1) return true;
    } else if(o.r===w.r && o.c===w.c){
      return true;
    }
  }
  return false;
}
function wallInBounds(w){ return w.r>=0 && w.r<=N-2 && w.c>=0 && w.c<=N-2; }

function bfsShortestPath(start, goalRow, blocked){
  const visited = new Set([posKey(start)]);
  let queue = [start], dist = 0;
  while(queue.length){
    const next = [];
    for(const cur of queue){
      if(cur.r === goalRow) return dist;
      for(const [dr,dc] of [[-1,0],[1,0],[0,-1],[0,1]]){
        const nr=cur.r+dr, nc=cur.c+dc;
        if(!inBounds(nr,nc)) continue;
        const np = {r:nr,c:nc};
        if(!canMoveBetween(cur,np,blocked)) continue;
        const k = posKey(np);
        if(visited.has(k)) continue;
        visited.add(k);
        next.push(np);
      }
    }
    queue = next; dist++;
  }
  return Infinity;
}
function bfsPathWithParents(start, goalRow, blocked){
  const visited = new Map([[posKey(start), null]]);
  let queue = [start];
  let goalNode = null;
  while(queue.length && !goalNode){
    const next = [];
    for(const cur of queue){
      if(cur.r === goalRow){ goalNode = cur; break; }
      for(const [dr,dc] of [[-1,0],[1,0],[0,-1],[0,1]]){
        const nr=cur.r+dr, nc=cur.c+dc;
        if(!inBounds(nr,nc)) continue;
        const np = {r:nr,c:nc};
        if(!canMoveBetween(cur,np,blocked)) continue;
        const k = posKey(np);
        if(visited.has(k)) continue;
        visited.set(k, cur);
        next.push(np);
      }
    }
    if(goalNode) break;
    queue = next;
    if(!queue.length) break;
  }
  if(!goalNode) return null;
  const path = [goalNode];
  let ck = posKey(goalNode);
  while(visited.get(ck)){
    const parent = visited.get(ck);
    path.unshift(parent);
    ck = posKey(parent);
  }
  return path;
}

function getValidPawnMoves(playerPos, oppPos, blocked){
  const moves = [];
  for(const [dr,dc] of [[-1,0],[1,0],[0,-1],[0,1]]){
    const nr = playerPos.r+dr, nc = playerPos.c+dc;
    if(!inBounds(nr,nc)) continue;
    const step1 = {r:nr,c:nc};
    if(!canMoveBetween(playerPos, step1, blocked)) continue;
    if(nr === oppPos.r && nc === oppPos.c){
      const jr = nr+dr, jc = nc+dc;
      const step2 = {r:jr,c:jc};
      if(inBounds(jr,jc) && canMoveBetween(step1, step2, blocked)){
        moves.push(step2);
      } else {
        const perp = dr!==0 ? [[0,-1],[0,1]] : [[-1,0],[1,0]];
        for(const [pdr,pdc] of perp){
          const dr2 = nr+pdr, dc2 = nc+pdc;
          const diag = {r:dr2,c:dc2};
          if(inBounds(dr2,dc2) && canMoveBetween(step1, diag, blocked)){
            moves.push(diag);
          }
        }
      }
    } else {
      moves.push(step1);
    }
  }
  return moves;
}

function isLegalWall(w, walls, p1, p2){
  if(!wallInBounds(w)) return false;
  if(wallOverlaps(w, walls)) return false;
  const blocked = computeBlockedEdges([...walls, w]);
  if(bfsShortestPath(p1, GOAL_ROW.p1, blocked) === Infinity) return false;
  if(bfsShortestPath(p2, GOAL_ROW.p2, blocked) === Infinity) return false;
  return true;
}

const GOAL_ROW = { p1: 0, p2: N-1 };
const START_POS = { p1: {r:N-1,c:4}, p2: {r:0,c:4} };
const TURN_SECONDS = 45;
const DISCONNECT_TIMEOUT_MS = 60000;

/* ============================================================
   GAME STATE
   ============================================================ */
let state = null;
function freshState(mode, difficulty){
  return {
    mode,
    difficulty,
    aiPlayer: 'p2',
    p1: {...START_POS.p1},
    p2: {...START_POS.p2},
    walls: [],
    wallsRemaining: {p1:10, p2:10},
    current: 'p1',
    moveCount: 0,
    history: [],
    over: false,
    winner: null,
    resignedBy: null,
    timedOutBy: null,
    disconnectedBy: null,
    turnStartedAt: Date.now(),
  };
}
function snapshot(s){
  return {
    p1:{...s.p1}, p2:{...s.p2}, walls:s.walls.map(w=>({...w})),
    wallsRemaining:{...s.wallsRemaining}, current:s.current, moveCount:s.moveCount
  };
}
function restore(s, snap){
  s.p1=snap.p1; s.p2=snap.p2; s.walls=snap.walls;
  s.wallsRemaining=snap.wallsRemaining; s.current=snap.current; s.moveCount=snap.moveCount;
}

function otherPlayer(p){ return p==='p1' ? 'p2' : 'p1'; }

function applyMove(s, mover, dest){
  s.history.push(snapshot(s));
  s[mover] = dest;
  s.moveCount++;
  s.current = otherPlayer(mover);
  s.turnStartedAt = Date.now();
}
function applyWall(s, mover, w){
  s.history.push(snapshot(s));
  s.walls.push(w);
  s.wallsRemaining[mover]--;
  s.moveCount++;
  s.current = otherPlayer(mover);
  s.turnStartedAt = Date.now();
}
function checkWin(s){
  if(s.p1.r === GOAL_ROW.p1) return 'p1';
  if(s.p2.r === GOAL_ROW.p2) return 'p2';
  return null;
}

/* ============================================================
   AI
   ============================================================ */
function evaluate(s, forPlayer){
  const blocked = computeBlockedEdges(s.walls);
  const opp = otherPlayer(forPlayer);
  const myDist = bfsShortestPath(s[forPlayer], GOAL_ROW[forPlayer], blocked);
  const oppDist = bfsShortestPath(s[opp], GOAL_ROW[opp], blocked);
  const wallDiff = s.wallsRemaining[forPlayer] - s.wallsRemaining[opp];
  return (oppDist - myDist) * 3 + wallDiff * 0.6;
}

function generateWallCandidates(s, mover, limit){
  const opp = otherPlayer(mover);
  const blocked = computeBlockedEdges(s.walls);
  const oppPath = bfsPathWithParents(s[opp], GOAL_ROW[opp], blocked);
  const myPath = bfsPathWithParents(s[mover], GOAL_ROW[mover], blocked);
  const candidates = [];
  const seen = new Set();
  function tryAdd(w){
    const k = w.orient+w.r+','+w.c;
    if(seen.has(k)) return;
    seen.add(k);
    if(s.wallsRemaining[mover] > 0 && isLegalWall(w, s.walls, s.p1, s.p2)){
      candidates.push(w);
    }
  }
  if(oppPath){
    for(let i=0;i<oppPath.length-1;i++){
      const a = oppPath[i], b = oppPath[i+1];
      if(a.r === b.r){
        const c = Math.min(a.c,b.c);
        tryAdd({r:a.r, c, orient:'V'});
        tryAdd({r:a.r-1, c, orient:'V'});
      } else {
        const r = Math.min(a.r,b.r);
        tryAdd({r, c:a.c, orient:'H'});
        tryAdd({r, c:a.c-1, orient:'H'});
      }
      if(candidates.length >= limit*2) break;
    }
  }
  if(myPath && myPath.length>1){
    const a = myPath[0], b = myPath[1];
    if(a.r===b.r){ tryAdd({r:a.r,c:Math.min(a.c,b.c),orient:'V'}); }
    else { tryAdd({r:Math.min(a.r,b.r),c:a.c,orient:'H'}); }
  }
  return candidates.slice(0, limit);
}

function generateMoves(s, mover, includeWalls, wallLimit){
  const blocked = computeBlockedEdges(s.walls);
  const opp = otherPlayer(mover);
  const moves = getValidPawnMoves(s[mover], s[opp], blocked).map(dest=>({type:'move', dest}));
  let wallMoves = [];
  if(includeWalls && s.wallsRemaining[mover] > 0){
    wallMoves = generateWallCandidates(s, mover, wallLimit).map(w=>({type:'wall', wall:w}));
  }
  return moves.concat(wallMoves);
}

function applyActionSim(s, mover, action){
  const ns = {
    p1:{...s.p1}, p2:{...s.p2}, walls: action.type==='wall' ? [...s.walls, action.wall] : s.walls,
    wallsRemaining: {...s.wallsRemaining}
  };
  if(action.type==='move'){ ns[mover] = action.dest; }
  else { ns.wallsRemaining[mover] = ns.wallsRemaining[mover]-1; }
  return ns;
}

function minimax(s, mover, root, depth, alpha, beta, maximizing, wallLimit){
  const p1win = s.p1.r === GOAL_ROW.p1, p2win = s.p2.r === GOAL_ROW.p2;
  if(p1win || p2win || depth===0){
    const terminal = { p1:s.p1,p2:s.p2,walls:s.walls,wallsRemaining:s.wallsRemaining };
    let score = evaluate(terminal, root);
    if(p1win) score += (root==='p1') ? 1000 : -1000;
    if(p2win) score += (root==='p2') ? 1000 : -1000;
    return score;
  }
  const actions = generateMoves(s, mover, depth>1, wallLimit);
  if(!actions.length) return evaluate(s, root);
  let best = maximizing ? -Infinity : Infinity;
  for(const action of actions){
    const ns = applyActionSim(s, mover, action);
    const val = minimax(ns, otherPlayer(mover), root, depth-1, alpha, beta, !maximizing, wallLimit);
    if(maximizing){ best = Math.max(best, val); alpha = Math.max(alpha, val); }
    else { best = Math.min(best, val); beta = Math.min(beta, val); }
    if(beta <= alpha) break;
  }
  return best;
}

function aiChooseAction(s, difficulty){
  const mover = s.aiPlayer;
  if(difficulty === 'easy'){
    const moves = generateMoves(s, mover, Math.random()<0.25, 4);
    return moves[Math.floor(Math.random()*moves.length)];
  }
  const depth = difficulty === 'hard' ? 3 : 2;
  const wallLimit = difficulty === 'hard' ? 6 : 4;
  const actions = generateMoves(s, mover, true, wallLimit);
  let bestAction = actions[0], bestScore = -Infinity;
  for(const action of actions){
    const ns = applyActionSim(s, mover, action);
    const score = minimax(ns, otherPlayer(mover), mover, depth-1, -Infinity, Infinity, false, wallLimit);
    if(score > bestScore){ bestScore = score; bestAction = action; }
  }
  return bestAction;
}

