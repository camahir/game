/* ============================================================
   WALL TRAY
   ============================================================ */
function canHumanPlaceWalls(){
  if(!state || state.over) return false;
  return isLocalTurn() && state.wallsRemaining[state.current] > 0;
}

function updateWallTray(){
  const tileH = document.getElementById('tile-h');
  const tileV = document.getElementById('tile-v');
  if(!state || !tileH) return;
  const enabled = canHumanPlaceWalls();
  [tileH, tileV].forEach(t=>{ t.classList.toggle('disabled', !enabled); });
  tileH.classList.toggle('armed', armedOrient==='H');
  tileV.classList.toggle('armed', armedOrient==='V');
  const color = state.current==='p1' ? 'var(--p1)' : 'var(--p2)';
  tileH.style.setProperty('--current-color', color);
  tileV.style.setProperty('--current-color', color);
}

function setArmed(orient){
  pendingWall = null;
  armedOrient = (armedOrient === orient) ? null : orient;
  if(armedOrient) sfxArm();
  renderBoard();
}

let dragState = null;
const TAP_MOVE_THRESHOLD = 8;

function clientToSvg(clientX, clientY){
  const rect = svgEl.getBoundingClientRect();
  return {
    x: (clientX - rect.left) * (SVG_SIZE / rect.width),
    y: (clientY - rect.top) * (SVG_SIZE / rect.height),
    overBoard: clientX>=rect.left && clientX<=rect.right && clientY>=rect.top && clientY<=rect.bottom
  };
}
function nearestSlot(svgX, svgY){
  let r = Math.round((svgY - CELL - GAP/2) / STEP);
  let c = Math.round((svgX - CELL - GAP/2) / STEP);
  r = Math.max(0, Math.min(N-2, r));
  c = Math.max(0, Math.min(N-2, c));
  return {r,c};
}
function sizeGhost(ghost, orient){
  const rect = svgEl.getBoundingClientRect();
  const scale = rect.width / SVG_SIZE;
  const long = (2*CELL + GAP) * scale;
  const short = Math.max(11, GAP * scale * 2.4);
  if(orient==='H'){ ghost.style.width = long+'px'; ghost.style.height = short+'px'; }
  else { ghost.style.width = short+'px'; ghost.style.height = long+'px'; }
}
function positionGhost(ghost, x, y){
  ghost.style.transform = `translate(${x - ghost.offsetWidth/2}px, ${y - ghost.offsetHeight/2}px)`;
}
function drawPreview(wall, legal){
  clearPreview();
  const ns = 'http://www.w3.org/2000/svg';
  const rect = document.createElementNS(ns,'rect');
  rect.id = 'wall-preview';
  rect.setAttribute('rx', 3);
  if(wall.orient==='H'){
    rect.setAttribute('x', cellX(wall.c)); rect.setAttribute('y', cellY(wall.r)+CELL);
    rect.setAttribute('width', 2*CELL+GAP); rect.setAttribute('height', GAP);
  } else {
    rect.setAttribute('x', cellX(wall.c)+CELL); rect.setAttribute('y', cellY(wall.r));
    rect.setAttribute('width', GAP); rect.setAttribute('height', 2*CELL+GAP);
  }
  rect.setAttribute('fill', legal ? 'var(--success)' : 'var(--danger)');
  rect.setAttribute('fill-opacity', legal ? '0.55' : '0.4');
  rect.setAttribute('stroke', legal ? 'var(--success)' : 'var(--danger)');
  rect.setAttribute('stroke-width', '2');
  rect.style.pointerEvents = 'none';
  svgEl.appendChild(rect);
}
function clearPreview(){
  const existing = document.getElementById('wall-preview');
  if(existing) existing.remove();
}

function attachTileDrag(tileEl, orient){
  tileEl.addEventListener('pointerdown', (e)=>{
    if(!canHumanPlaceWalls()) return;
    if(e.pointerType==='mouse' && e.button !== 0) return;
    e.preventDefault();
    ensureAudio();
    const ghost = document.createElement('div');
    ghost.id = 'drag-ghost';
    document.body.appendChild(ghost);
    sizeGhost(ghost, orient);
    positionGhost(ghost, e.clientX, e.clientY);
    tileEl.classList.add('dragging');
    tileEl.setPointerCapture(e.pointerId);
    dragState = { orient, pointerId:e.pointerId, ghostEl:ghost, tileEl, overBoard:false, wall:null, startX:e.clientX, startY:e.clientY, moved:false };
  });
  tileEl.addEventListener('pointermove', (e)=>{
    if(!dragState || e.pointerId !== dragState.pointerId) return;
    if(Math.hypot(e.clientX-dragState.startX, e.clientY-dragState.startY) > TAP_MOVE_THRESHOLD){
      dragState.moved = true;
    }
    positionGhost(dragState.ghostEl, e.clientX, e.clientY);
    const { x, y, overBoard } = clientToSvg(e.clientX, e.clientY);
    if(overBoard){
      const { r, c } = nearestSlot(x, y);
      const wall = { r, c, orient: dragState.orient };
      const legal = isLegalWall(wall, state.walls, state.p1, state.p2);
      drawPreview(wall, legal);
      dragState.overBoard = true;
      dragState.wall = wall;
      dragState.ghostEl.classList.toggle('valid', legal);
      dragState.ghostEl.classList.toggle('invalid', !legal);
    } else {
      clearPreview();
      dragState.overBoard = false;
      dragState.wall = null;
      dragState.ghostEl.classList.remove('valid','invalid');
    }
  });
  function endDrag(e){
    if(!dragState || e.pointerId !== dragState.pointerId) return;
    const { ghostEl, tileEl:el, overBoard, wall, moved, orient:dOrient } = dragState;
    try{ el.releasePointerCapture(e.pointerId); }catch(err){}
    el.classList.remove('dragging');
    clearPreview();
    ghostEl.remove();
    const stillOk = canHumanPlaceWalls();
    dragState = null;
    if(stillOk && overBoard && wall){
      const legalNow = isLegalWall(wall, state.walls, state.p1, state.p2);
      humanWall(wall);
      if(!legalNow){
        el.classList.add('shake');
        setTimeout(()=>el.classList.remove('shake'), 320);
      }
    } else if(stillOk && !moved){
      setArmed(dOrient);
    }
  }
  tileEl.addEventListener('pointerup', endDrag);
  tileEl.addEventListener('pointercancel', endDrag);
  tileEl.addEventListener('contextmenu', (e)=>e.preventDefault());
}
attachTileDrag(document.getElementById('tile-h'), 'H');
attachTileDrag(document.getElementById('tile-v'), 'V');

/* ============================================================
   INTERACTION FLOW
   ============================================================ */
function refreshSelection(){
  if(state.over){ selectedValidMoves = []; return; }
  if(!isLocalTurn()){ selectedValidMoves = []; return; }
  const blocked = computeBlockedEdges(state.walls);
  const mover = state.current, opp = otherPlayer(mover);
  selectedValidMoves = getValidPawnMoves(state[mover], state[opp], blocked);
}

function humanMove(dest){
  if(state.over) return;
  const mover = state.current;
  const valid = selectedValidMoves.some(m=>m.r===dest.r && m.c===dest.c);
  if(!valid){ sfxInvalid(); return; }
  sfxClick();
  applyMove(state, mover, dest);
  afterHalfMove();
}
function humanWall(w){
  if(state.over) return;
  const mover = state.current;
  if(state.wallsRemaining[mover] <= 0) return;
  if(!isLegalWall(w, state.walls, state.p1, state.p2)){ sfxInvalid(); return; }
  sfxWall();
  applyWall(state, mover, w);
  afterHalfMove();
}

function afterHalfMove(){
  clearArmed();
  const winner = checkWin(state);
  if(winner){ state.over = true; state.winner = winner; }
  refreshSelection();
  renderBoard();
  if(state.mode==='online') pushOnlineState();
  if(winner){ finishGame(winner); return; }
  maybeTriggerAI();
}

function maybeTriggerAI(){
  if(state.mode !== 'ai') return;
  if(state.current !== state.aiPlayer) return;
  clearArmed();
  renderBoard();
  setTimeout(()=>{
    const action = aiChooseAction(state, state.difficulty);
    if(action){
      if(action.type==='move'){ applyMove(state, state.aiPlayer, action.dest); sfxClick(); }
      else { applyWall(state, state.aiPlayer, action.wall); sfxWall(); }
    }
    const winner = checkWin(state);
    refreshSelection();
    renderBoard();
    if(winner) finishGame(winner);
  }, 420 + Math.random()*380);
}

function finishGame(winner){
  state.over = true;
  if(!state.winner) state.winner = winner;
  if(state.mode==='ai'){
    stats.played++;
    if(winner==='p1') stats.wins++; else stats.losses++;
    savePersisted();
  } else if(state.mode==='online'){
    stats.played++;
    if(winner===onlineRole) stats.wins++; else stats.losses++;
    savePersisted();
  }
  setTimeout(()=>showVictory(winner), 550);
}

