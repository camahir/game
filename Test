  showView('view-online');
});
document.getElementById('btn-online-back').addEventListener('click', ()=> showView('view-home'));
document.getElementById('btn-create-room').addEventListener('click', ()=>{ ensureAudio(); createOnlineRoom(); });
document.getElementById('btn-join-room').addEventListener('click', ()=>{
  ensureAudio();
  joinOnlineRoom(document.getElementById('join-code-input').value);
});
document.getElementById('join-code-input').addEventListener('input', (e)=>{
  e.target.value = e.target.value.trim().toUpperCase();
});
document.getElementById('join-code-input').addEventListener('keydown', (e)=>{
  if(e.key==='Enter'){ ensureAudio(); joinOnlineRoom(e.target.value); }
});
document.getElementById('btn-waiting-cancel').addEventListener('click', ()=>{
  leaveOnlineRoom();
  showView('view-online');
});
document.getElementById('btn-copy-code').addEventListener('click', async ()=>{
  const b = document.getElementById('btn-copy-code');
  try{
    await navigator.clipboard.writeText(onlineRoomCode || '');
    const old = b.textContent;
    b.textContent = 'Copied!';
    setTimeout(()=>{ b.textContent = old; }, 1200);
  }catch(e){
    const old = b.textContent;
    b.textContent = 'Copy failed';
    setTimeout(()=>{ b.textContent = old; }, 1200);
  }
});

document.addEventListener('keydown', (e)=>{
  const gameActive = document.getElementById('view-game').classList.contains('active');
  if(!gameActive || !state || state.over) return;
  if(!isLocalTurn()) return;
  if(e.key === 'Escape' && (armedOrient || pendingWall)){ armedOrient = null; pendingWall = null; renderBoard(); return; }
  const map = {ArrowUp:[-1,0], ArrowDown:[1,0], ArrowLeft:[0,-1], ArrowRight:[0,1]};
  if(!map[e.key]) return;
  e.preventDefault();
  const [dr,dc] = map[e.key];
  const pos = state[state.current];
  const target = selectedValidMoves.find(m=>{
    const ddr = Math.sign(m.r-pos.r), ddc = Math.sign(m.c-pos.c);
    return ddr===dr && ddc===dc;
  }) || selectedValidMoves.find(m=> (m.r-pos.r)===dr*2 && dc===0 && dr!==0) || null;
  if(target) humanMove(target);
});

loadPersisted();
})();
</script>
</body>
</html>
