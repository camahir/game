/* ============================================================
   ONLINE MULTIPLAYER — Supabase
   Each "room" is one row in a `rooms` table. The room code is the
   primary key. Moves are pushed as row updates; both clients
   subscribe to Postgres Realtime changes filtered to their row,
   so state propagates in real time with no polling.

   ---- ONE-TIME SUPABASE SETUP ----
   1. Create a free project at https://supabase.com
   2. Open the SQL editor and run:

      create table rooms (
        code text primary key,
        status text not null default 'waiting',
        rev integer not null default 1,
        game jsonb not null,
        updated_at timestamptz not null default now()
      );
      alter table rooms enable row level security;
      create policy "public read" on rooms for select using (true);
      create policy "public insert" on rooms for insert with check (true);
      create policy "public update" on rooms for update using (true);
      alter publication supabase_realtime add table rooms;

      This makes rooms world-readable/writable by anyone holding your
      anon key — the same trust model as an anonymous game code, fine
      for a casual game, not for anything sensitive.

   3. Settings > API: copy the Project URL and the "anon public" key
      into SUPABASE_URL / SUPABASE_ANON_KEY below.
   4. Database > Replication: confirm "rooms" is enabled for Realtime
      (the ALTER PUBLICATION statement above already does this, but
      double-check if rows don't sync).
   ============================================================ */
const SUPABASE_URL = 'YOUR_SUPABASE_URL';       // e.g. https://xxxxxxxx.supabase.co
const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';

let supabaseClient = null;
function getSupabase(){
  if(supabaseClient) return supabaseClient;
  if(typeof window.supabase === 'undefined') throw new Error('sdk-not-loaded');
  if(SUPABASE_URL.indexOf('YOUR_SUPABASE_URL') !== -1 || SUPABASE_ANON_KEY.indexOf('YOUR_SUPABASE_ANON_KEY') !== -1){
    throw new Error('not-configured');
  }
  supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    realtime: { params: { eventsPerSecond: 10 } }
  });
  return supabaseClient;
}

let onlineRoomCode = null;   // room code == primary key of the row
let onlineRole = null;       // 'p1' (creator) | 'p2' (joiner)
let onlineLastRev = 0;       // last-seen revision, to avoid reprocessing our own writes
let onlineChannel = null;    // active Supabase Realtime channel
let onlineFallbackTimer = null; // backup poll in case a realtime event is missed

function genRoomCode(){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no 0/O/1/I, avoids ambiguity
  let out = '';
  for(let i=0;i<5;i++) out += chars[Math.floor(Math.random()*chars.length)];
  return out;
}

function freshOnlineGameCore(){
  return {
    p1:{...START_POS.p1}, p2:{...START_POS.p2}, walls:[],
    wallsRemaining:{p1:10,p2:10}, current:'p1', moveCount:0,
    over:false, winner:null, resignedBy:null, timedOutBy:null, disconnectedBy:null,
    turnStartedAt: Date.now()
  };
}

function isLocalTurn(){
  if(!state || state.over) return false;
  if(state.mode==='pass') return true;
  if(state.mode==='online') return state.current === onlineRole;
  return state.current !== state.aiPlayer;
}

async function insertRoomRow(){
  const sb = getSupabase();
  for(let attempt=0; attempt<5; attempt++){
    const code = genRoomCode();
    const { error } = await sb.from('rooms').insert({
      code, status:'waiting', rev:1, game: freshOnlineGameCore()
    });
    if(!error) return code;
    if(error.code !== '23505') throw error; // anything but a code collision is fatal
  }
  throw new Error('could-not-allocate-code');
}

async function fetchRoomRow(code){
  const sb = getSupabase();
  const { data, error } = await sb.from('rooms').select('*').eq('code', code).maybeSingle();
  if(error) throw error;
  return data;
}

async function updateRoomRow(code, patch){
  const sb = getSupabase();
  const { error } = await sb.from('rooms').update(patch).eq('code', code);
  if(error) throw error;
}

async function createOnlineRoom(){
  const btn = document.getElementById('btn-create-room');
  const errEl = document.getElementById('online-error');
  errEl.textContent = '';
  btn.disabled = true; btn.textContent = 'Creating…';
  try{
    const code = await insertRoomRow();
    onlineRoomCode = code; onlineRole = 'p1'; onlineLastRev = 1;
    document.getElementById('room-code-display').textContent = code;
    showView('view-waiting');
    subscribeToRoom(code);
  }catch(e){
    errEl.textContent = friendlyOnlineError(e);
  }finally{
    btn.disabled = false; btn.textContent = 'Create a room';
  }
}

async function joinOnlineRoom(rawCode){
  const code = (rawCode||'').trim().toUpperCase();
  const errEl = document.getElementById('online-error');
  errEl.textContent = '';
  if(!code){ errEl.textContent = 'Enter a room code.'; return; }
  const btn = document.getElementById('btn-join-room');
  btn.disabled = true; btn.textContent = 'Joining…';
  try{
    const room = await fetchRoomRow(code);
    if(!room){
      errEl.textContent = "Couldn't find that room. Check the code and try again.";
      return;
    }
    if(room.status !== 'waiting'){
      errEl.textContent = 'That room is already full or has finished.';
      return;
    }
    const nextRev = (room.rev||0) + 1;
    await updateRoomRow(code, { status:'active', rev: nextRev, updated_at: new Date().toISOString() });
    onlineRoomCode = code; onlineRole = 'p2'; onlineLastRev = nextRev;
    room.status = 'active'; room.rev = nextRev;
    enterActiveOnlineGame(room);
    subscribeToRoom(code);
  }catch(e){
    errEl.textContent = friendlyOnlineError(e);
  }finally{
    btn.disabled = false; btn.textContent = 'Join room';
  }
}

function friendlyOnlineError(e){
  if(e && e.message === 'not-configured'){
    return 'Online play needs a Supabase URL and anon key — add them near the top of the script (SUPABASE_URL / SUPABASE_ANON_KEY).';
  }
  if(e && e.message === 'sdk-not-loaded'){
    return "Couldn't load the Supabase library. Check your connection and try again.";
  }
  return "Couldn't reach the server. Check your connection and Supabase project, then try again.";
}

function enterActiveOnlineGame(room){
  state = freshState('online', null);
  state.p1 = room.game.p1; state.p2 = room.game.p2; state.walls = room.game.walls;
  state.wallsRemaining = room.game.wallsRemaining; state.current = room.game.current;
  state.moveCount = room.game.moveCount; state.over = room.game.over;
  state.winner = room.game.winner; state.resignedBy = room.game.resignedBy;
  state.timedOutBy = room.game.timedOutBy || null;
  state.disconnectedBy = room.game.disconnectedBy || null;
  state.turnStartedAt = room.game.turnStartedAt || Date.now();
  clearArmed();
  refreshSelection();
  confettiRunning = false;
  hideDisconnectBanner();
  showView('view-game');
  renderBoard();
}

async function pushOnlineState(){
  if(!onlineRoomCode || !state || state.mode!=='online') return;
  const nextRev = onlineLastRev + 1;
  try{
    await updateRoomRow(onlineRoomCode, {
      game: {
        p1:state.p1, p2:state.p2, walls:state.walls, wallsRemaining:state.wallsRemaining,
        current:state.current, moveCount:state.moveCount, over:state.over,
        winner: state.winner||null, resignedBy: state.resignedBy||null,
        timedOutBy: state.timedOutBy||null, disconnectedBy: state.disconnectedBy||null,
        turnStartedAt: state.turnStartedAt
      },
      status: state.over ? 'finished' : 'active',
      rev: nextRev,
      updated_at: new Date().toISOString()
    });
    onlineLastRev = nextRev;
  }catch(e){ /* realtime/poll will just look one move behind; not fatal */ }
}

function subscribeToRoom(code){
  unsubscribeFromRoom();
  const sb = getSupabase();
  onlineChannel = sb
    .channel('room-'+code, { config: { presence: { key: onlineRole || 'anon' } } })
    .on('postgres_changes',
      { event:'UPDATE', schema:'public', table:'rooms', filter:`code=eq.${code}` },
      (payload) => handleRoomRow(payload.new)
    )
    .on('presence', { event:'sync' }, handlePresenceChange)
    .on('presence', { event:'join' }, handlePresenceChange)
    .on('presence', { event:'leave' }, handlePresenceChange)
    .subscribe(async (status)=>{
      if(status === 'SUBSCRIBED'){
        try{ await onlineChannel.track({ role: onlineRole, at: Date.now() }); }catch(e){}
      }
    });
  onlineFallbackTimer = setInterval(async ()=>{
    if(!onlineRoomCode) return;
    try{
      const room = await fetchRoomRow(onlineRoomCode);
      if(room) handleRoomRow(room);
    }catch(e){}
  }, 4000);
}
function unsubscribeFromRoom(){
  if(onlineChannel){
    try{ getSupabase().removeChannel(onlineChannel); }catch(e){}
    onlineChannel = null;
  }
  if(onlineFallbackTimer){ clearInterval(onlineFallbackTimer); onlineFallbackTimer = null; }
  clearDisconnectTimer();
}

function handleRoomRow(room){
  if(!room || room.rev === onlineLastRev) return;
  onlineLastRev = room.rev;

  if(room.status === 'waiting') return;

  if(room.status === 'active' && document.getElementById('view-waiting').classList.contains('active')){
    enterActiveOnlineGame(room);
    return;
  }

  if(!state || state.mode !== 'online') return;
  state.p1 = room.game.p1; state.p2 = room.game.p2; state.walls = room.game.walls;
  state.wallsRemaining = room.game.wallsRemaining; state.current = room.game.current;
  state.moveCount = room.game.moveCount; state.over = room.game.over;
  state.winner = room.game.winner; state.resignedBy = room.game.resignedBy;
  state.timedOutBy = room.game.timedOutBy || null;
  state.disconnectedBy = room.game.disconnectedBy || null;
  state.turnStartedAt = room.game.turnStartedAt || Date.now();
  clearArmed();
  refreshSelection();
  if(state.over){
    if(!document.getElementById('view-victory').classList.contains('active')){
      finishGame(state.winner);
    }
  } else {
    if(!document.getElementById('view-game').classList.contains('active')){
      confettiRunning = false;
      showView('view-game');
    }
    renderBoard();
  }
}

function onlineRematch(){
  const core = freshOnlineGameCore();
  state.p1 = core.p1; state.p2 = core.p2; state.walls = []; state.wallsRemaining = {p1:10,p2:10};
  state.current = 'p1'; state.moveCount = 0; state.over = false; state.winner = null;
  state.resignedBy = null; state.timedOutBy = null; state.disconnectedBy = null;
  state.turnStartedAt = Date.now(); state.history = [];
  clearArmed();
  refreshSelection();
  confettiRunning = false;
  hideDisconnectBanner();
  showView('view-game');
  renderBoard();
  pushOnlineState();
}

function leaveOnlineRoom(){
  unsubscribeFromRoom();
  onlineRoomCode = null; onlineRole = null; onlineLastRev = 0;
}

