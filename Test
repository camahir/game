function showVictory(winner){
  const title = document.getElementById('victory-title');
  const sub = document.getElementById('victory-sub');
  const emoji = document.getElementById('victory-emoji');
  if(state.mode==='pass'){
    title.textContent = (winner==='p1'?'Player 1':'Player 2') + ' wins';
    sub.textContent = state.timedOutBy ? 'The other player ran out of time.' : 'Reached the far side first.';
    emoji.textContent = state.timedOutBy ? '⏱️' : '🏆';
  } else if(state.mode==='online'){
    const youWon = winner === onlineRole;
    title.textContent = youWon ? 'You win' : 'Opponent wins';
    if(state.disconnectedBy){
      sub.textContent = state.disconnectedBy===onlineRole ? 'You disconnected.' : 'Opponent disconnected for too long.';
      emoji.textContent = youWon ? '📡' : '🤝';
    } else if(state.timedOutBy){
      sub.textContent = state.timedOutBy===onlineRole ? 'You ran out of time.' : 'Opponent ran out of time.';
      emoji.textContent = youWon ? '⏱️' : '🤝';
    } else if(state.resignedBy){
      sub.textContent = state.resignedBy===onlineRole ? 'You resigned.' : 'Opponent resigned.';
      emoji.textContent = youWon ? '🏆' : '🤝';
    } else {
      sub.textContent = youWon ? 'You reached the far side first.' : 'They reached the far side first.';
      emoji.textContent = youWon ? '🏆' : '🤝';
    }
  } else if(winner==='p1'){
    title.textContent = 'You win';
    sub.textContent = state.timedOutBy ? 'The computer ran out of time.' : 'You out-maneuvered the computer.';
    emoji.textContent = state.timedOutBy ? '⏱️' : '🏆';
  } else {
    title.textContent = 'Computer wins';
    sub.textContent = state.timedOutBy ? 'You ran out of time.' : 'Better luck on the next crossing.';
    emoji.textContent = state.timedOutBy ? '⏱️' : '🤖';
  }
  document.getElementById('victory-moves').textContent = state.moveCount;
  document.getElementById('victory-walls').textContent = (10-state.wallsRemaining.p1)+(10-state.wallsRemaining.p2);
  showView('view-victory');
  sfxVictory();
  if(!settings.reduceMotion) runConfetti();
  renderHomeStats();
}

/* ============================================================
   CONFETTI
   ============================================================ */
let confettiRunning = false;
function runConfetti(){
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  function resize(){ canvas.width = canvas.offsetWidth * devicePixelRatio; canvas.height = canvas.offsetHeight * devicePixelRatio; }
  resize();
  const colors = ['#4c7eff','#f2a65a','#eef0f3','#5fcf8f'];
  const pieces = Array.from({length:80}, ()=>({
    x: Math.random()*canvas.width, y: -20 - Math.random()*canvas.height*0.4,
    vx: (Math.random()-0.5)*3*devicePixelRatio, vy: (2+Math.random()*3)*devicePixelRatio,
    size: (4+Math.random()*5)*devicePixelRatio, color: colors[Math.floor(Math.random()*colors.length)],
    rot: Math.random()*Math.PI, vr: (Math.random()-0.5)*0.2
  }));
  confettiRunning = true;
  let frames = 0;
  function tick(){
    if(!confettiRunning) return;
    ctx.clearRect(0,0,canvas.width,canvas.height);
    for(const p of pieces){
      p.x += p.vx; p.y += p.vy; p.vy += 0.03*devicePixelRatio; p.rot += p.vr;
      ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.fillStyle = p.color; ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6);
      ctx.restore();
    }
    frames++;
    if(frames < 260) requestAnimationFrame(tick); else confettiRunning=false;
  }
  tick();
}

/* ============================================================
   TURN TIMER
   ============================================================ */
function formatClock(ms){
  const total = Math.max(0, Math.ceil(ms/1000));
  const m = Math.floor(total/60), s = total%60;
  return m+':'+String(s).padStart(2,'0');
}

function handleTurnTimeout(){
  if(!state || state.over) return;
  const loser = state.current;
  const winner = otherPlayer(loser);
  state.over = true;
  state.winner = winner;
  state.timedOutBy = loser;
  if(state.mode==='online') pushOnlineState();
  finishGame(winner);
}

function tickTurnTimer(){
  const pill = document.getElementById('turn-timer');
  if(!pill) return;
  const gameActive = document.getElementById('view-game').classList.contains('active');
  if(!gameActive || !state || state.over){
    pill.classList.remove('warn','danger');
    pill.textContent = formatClock(TURN_SECONDS*1000);
    return;
  }
  const remaining = TURN_SECONDS*1000 - (Date.now() - (state.turnStartedAt||Date.now()));
  pill.textContent = formatClock(remaining);
  pill.classList.toggle('warn', remaining <= 15000 && remaining > 5000);
  pill.classList.toggle('danger', remaining <= 5000);
  if(remaining <= 0){
    handleTurnTimeout();
  }
}
setInterval(tickTurnTimer, 250);

/* ============================================================
   DISCONNECT DETECTION
   ============================================================ */
let disconnectTimer = null;
let disconnectDeadline = 0;

function showDisconnectBanner(){
  const b = document.getElementById('disconnect-banner');
  if(b) b.classList.add('active');
}
function hideDisconnectBanner(){
  const b = document.getElementById('disconnect-banner');
  if(b) b.classList.remove('active');
}
function updateDisconnectBanner(remainingMs){
  const t = document.getElementById('disconnect-banner-text');
  if(t) t.textContent = `Opponent disconnected — you win in ${Math.max(0,Math.ceil(remainingMs/1000))}s…`;
}

function clearDisconnectTimer(){
  if(disconnectTimer){ clearInterval(disconnectTimer); disconnectTimer = null; }
  hideDisconnectBanner();
}
function armDisconnectTimer(){
  if(disconnectTimer) return;
  disconnectDeadline = Date.now() + DISCONNECT_TIMEOUT_MS;
  showDisconnectBanner();
  updateDisconnectBanner(DISCONNECT_TIMEOUT_MS);
  disconnectTimer = setInterval(()=>{
    const remaining = disconnectDeadline - Date.now();
    updateDisconnectBanner(remaining);
    if(remaining <= 0){
      clearInterval(disconnectTimer); disconnectTimer = null;
      hideDisconnectBanner();
      if(state && state.mode==='online' && !state.over && onlineRole){
        const winner = onlineRole;
        state.over = true;
        state.winner = winner;
        state.disconnectedBy = otherPlayer(onlineRole);
        pushOnlineState();
        finishGame(winner);
      }
    }
  }, 1000);
}

function handlePresenceChange(){
  if(!onlineChannel || !onlineRole || !state || state.mode!=='online' || state.over){
    clearDisconnectTimer();
    return;
  }
  const presenceState = onlineChannel.presenceState();
  const oppRole = otherPlayer(onlineRole);
  const oppPresent = Object.values(presenceState).some(arr => arr.some(p => p.role === oppRole));
  if(oppPresent) clearDisconnectTimer();
  else armDisconnectTimer();
}

